-- --- ORTAK TAKIM KONTROLÜ (Ground War Team Check) ---
local function isEnemy(otherPlayer)
	if not otherPlayer or otherPlayer == player then return false end
	
	if player.Team ~= nil and otherPlayer.Team ~= nil then
		if player.Team == otherPlayer.Team then
			return false
		end
	end
	
	if player.TeamColor ~= nil and otherPlayer.TeamColor ~= nil then
		if player.TeamColor == otherPlayer.TeamColor then
			return false
		end
	end
	
	local pTeamVal = player:FindFirstChild("Team") or player:FindFirstChild("TeamValue")
	local oTeamVal = otherPlayer:FindFirstChild("Team") or otherPlayer:FindFirstChild("TeamValue")
	if pTeamVal and oTeamVal and pTeamVal.Value == oTeamVal.Value then
		return false
	end

	return true
end

-- Ground War Uyumlu Can Tespiti Fonksiyonu
local function getGroundWarHealth(otherPlayer)
	local char = otherPlayer.Character
	if not char then return 0, 100 end
	
	-- 1. Yöntem: Standart Roblox Humanoid
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		return math.floor(hum.Health), math.floor(hum.MaxHealth)
	end
	
	-- 2. Yöntem: Ground War Özel Health / HP Nesneleri (Value)
	local hpVal = char:FindFirstChild("Health") or char:FindFirstChild("HP") or otherPlayer:FindFirstChild("Health") or otherPlayer:FindFirstChild("HP")
	local maxHpVal = char:FindFirstChild("MaxHealth") or char:FindFirstChild("MaxHP") or otherPlayer:FindFirstChild("MaxHealth") or otherPlayer:FindFirstChild("MaxHP")
	
	if hpVal and hpVal:IsA("ValueBase") then
		local currentHp = math.floor(tonumber(hpVal.Value) or 0)
		local maxHp = maxHpVal and maxHpVal:IsA("ValueBase") and math.floor(tonumber(maxHpVal.Value) or 100) or 100
		return currentHp, maxHp
	end
	
	return 100, 100
end

