local pTp = addPage("Tp")

local function getGunShopsList()
	local list = {}
	for _, obj in pairs(Workspace:GetDescendants()) do
		local nameLower = string.lower(obj.Name)
		if string.find(nameLower, "gun") or string.find(nameLower, "silah") or string.find(nameLower, "weapon") or string.find(nameLower, "shop") or string.find(nameLower, "ammu") then
			local pos = nil
			if obj:IsA("Model") then
				pcall(function() pos = obj:GetPivot().Position end)
			elseif obj:IsA("BasePart") then
				pos = obj.Position
			end
			if pos then
				local isUnique = true
				for _, existing in pairs(list) do
					if (existing - pos).Magnitude < 10 then
						isUnique = false
						break
					end
				end
				if isUnique then table.insert(list, pos) end
			end
		end
	end
	return list
end

