local function applyEsp(otherPlayer)
	if not isEnemy(otherPlayer) then
		if otherPlayer.Character then removeEspFromChar(otherPlayer.Character) end
		return
	end
	
	local char = otherPlayer.Character
	if not char then return end
	
	if not char:FindFirstChild("AselsanHighlight") then
		local hl = Instance.new("Highlight")
		hl.Name = "AselsanHighlight"
		hl.Adornee = char
		hl.FillColor = Color3.fromRGB(255, 30, 30)
		hl.FillTransparency = 0.4
		hl.OutlineColor = Color3.fromRGB(255, 255, 255)
		hl.OutlineTransparency = 0
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
