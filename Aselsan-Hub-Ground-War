		aimbotBtn.Text = "Enemy Head Aimbot (Açık)"
		fovCircle.Visible = true
		if aimbotConn then aimbotConn:Disconnect() end
		
		aimbotConn = RunService.RenderStepped:Connect(function()
			if not aimbotEnabled then
				fovCircle.Visible = false
				return
			end
			
			local cam = Workspace.CurrentCamera
			fovCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
			
			local targetHead = getBestTargetHead()
			if targetHead then
				local currentCFrame = cam.CFrame
				local targetCFrame = CFrame.new(currentCFrame.Position, targetHead.Position)
				cam.CFrame = currentCFrame:Lerp(targetCFrame, 0.35)
			end
		end)
	else
		aimbotBtn.Text = "Head Aimbot (Kapalı)"
		fovCircle.Visible = false
		if aimbotConn then
			aimbotConn:Disconnect()
			aimbotConn = nil
		end
	end
end)

