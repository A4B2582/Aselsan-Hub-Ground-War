local pFarm = addPage("Farm")

local function safeTeleport(destinationCFrame)
	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local hrp = char.HumanoidRootPart
	
	local startPos = hrp.Position
	local endPos = destinationCFrame.Position
	local distance = (endPos - startPos).Magnitude
	
	if distance < 30 then
		hrp.CFrame = destinationCFrame
		return
	end
	
	local steps = math.clamp(math.floor(distance / 25), 5, 25)
	for i = 1, steps do
		local alpha = i / steps
		local interpolatedPos = startPos:Lerp(endPos, alpha)
		hrp.CFrame = CFrame.new(interpolatedPos)
		task.wait(0.01)
	end
	hrp.CFrame = destinationCFrame
end

local function getSafesList()
	local list = {}
	for _, obj in pairs(Workspace:GetDescendants()) do
		local nameLower = string.lower(obj.Name)
		if nameLower == "safe" or string.find(nameLower, "kasa") or string.find(nameLower, "safebox") then
			local pos = nil
			if obj:IsA("Model") then
				pcall(function() pos = obj:GetPivot().Position end)
			elseif obj:IsA("BasePart") then
				pos = obj.Position
			end
			if pos then
				local isUnique = true
				for _, existingPos in pairs(list) do
					if (existingPos - pos).Magnitude < 6 then
						isUnique = false
						break
					end
				end
				if isUnique then table.insert(list, pos) end
			end
		end
	end
	for i = #list, 2, -1 do
		local j = math.random(i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

